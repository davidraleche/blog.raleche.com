# Postgres. Local: docker run -d --name raleche-pg -e POSTGRES_USER=raleche -e POSTGRES_PASSWORD=raleche -e POSTGRES_DB=raleche -p 5433:5432 postgres:16-alpine
DATABASE_URL="postgresql://raleche:raleche@localhost:5433/raleche"
APP_URL="http://localhost:3000"
SESSION_SECRET="change-me"
ADMIN_EMAIL="davidr@tech-team-strategy.com"
# Initial password for the admin account (used by `npm run db:seed` only if no password is set yet)
ADMIN_PASSWORD=""

# Google sign-in: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe: https://dashboard.stripe.com/apikeys  (webhook: {APP_URL}/api/stripe/webhook)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Twilio SMS for phone sign-in. Without it, codes are printed to the server log (dev only).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Resend for newsletter emails. Without it, sends are logged only.
RESEND_API_KEY=""
EMAIL_FROM="Raleche <newsletter@raleche.com>"

# Source for article import
IMPORT_SOURCE="https://tts42.com"
# Shared secret so tts42.com can push an article here (POST /api/import)
IMPORT_SECRET=""
TTS42_URL="https://tech-team-strategy.com"
