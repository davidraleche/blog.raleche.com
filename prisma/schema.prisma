generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String?   @unique
  phone            String?   @unique
  name             String?
  image            String?
  passwordHash     String?
  googleId         String?   @unique
  role             String    @default("USER") // USER | ADMIN
  stripeCustomerId String?   @unique
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime?
  sessions         Session[]
  subscriptions    Subscription[]
  posts            Post[]
}

model Session {
  id        String   @id // sha256 of the cookie token
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

model Plan {
  id          String   @id // "member" | "executive"
  name        String
  priceCents  Int
  interval    String   @default("month")
  tagline     String
  features    String   // newline separated
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  subscriptions Subscription[]
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId               String
  plan                 Plan     @relation(fields: [planId], references: [id])
  status               String   // active | trialing | past_due | canceled
  stripeSubscriptionId String?  @unique
  priceCents           Int
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Category {
  id        String  @id @default(cuid())
  name      String  @unique
  slug      String  @unique
  sortOrder Int     @default(0)
  posts     Post[]
}

model Post {
  id               String    @id @default(cuid())
  slug             String    @unique
  title            String
  dek              String    @default("") // subtitle / summary line
  body             String    // markdown
  executiveSummary String    @default("") // markdown, members only
  coverImage       String?
  tags             String    @default("") // comma separated
  status           String    @default("draft") // draft | published | scheduled
  featured         Boolean   @default(false)
  premium          Boolean   @default(false) // whole article members-only
  readMinutes      Int       @default(5)
  views            Int       @default(0)
  speaker          String?   // person interviewed, e.g. "Sam Altman"
  host             String?   // interviewer, e.g. "Lenny Rachitsky"
  show             String?   // podcast/channel, e.g. "Lenny's Podcast"
  source           String?   // e.g. tts42
  sourceUrl        String?   @unique
  categoryId       String?
  category         Category? @relation(fields: [categoryId], references: [id])
  authorId         String?
  author           User?     @relation(fields: [authorId], references: [id])
  authorName       String    @default("Raleche Staff")
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  dailyViews       PostView[]
}

model PostView {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  day    String // YYYY-MM-DD
  count  Int    @default(0)

  @@unique([postId, day])
}

model Subscriber {
  id             String   @id @default(cuid())
  email          String   @unique
  status         String   @default("subscribed") // subscribed | unsubscribed
  source         String   @default("site")
  unsubscribeKey String   @unique @default(cuid())
  createdAt      DateTime @default(now())
}

model Campaign {
  id        String    @id @default(cuid())
  subject   String
  body      String    // markdown
  status    String    @default("draft") // draft | sent
  sentCount Int       @default(0)
  sentAt    DateTime?
  createdAt DateTime  @default(now())
}

model Setting {
  key   String @id
  value String
}

model ImportRun {
  id        String   @id @default(cuid())
  source    String
  created   Int      @default(0)
  updated   Int      @default(0)
  errors    String   @default("")
  createdAt DateTime @default(now())
}

/// Machine translations, keyed by a hash of (language, format, source text), so edited text is retranslated automatically.
model Translation {
  id        String   @id
  lang      String
  text      String
  createdAt DateTime @default(now())
}
