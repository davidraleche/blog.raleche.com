generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String          @id @default(cuid())
  email            String?         @unique
  phone            String?         @unique
  name             String?
  image            String?
  passwordHash     String?
  googleId         String?         @unique
  role             String          @default("USER") // USER | ADMIN
  stripeCustomerId String?         @unique
  createdAt        DateTime        @default(now())
  lastSeenAt       DateTime?
  sessions         Session[]
  subscriptions    Subscription[]
  posts            Post[]
  tokenBalance     Int             @default(0)
  language         String? // preferred language for emails: en | fr | es | zh
  tokenTxns        TokenTxn[]
  unlocks          Unlock[]
  memoPurchases    MemoPurchase[]
  spins            WheelSpin[]
  votes            PollVote[]
  comments         Comment[]
  quizAttempts     QuizAttempt[]
  follows          Follow[]
  personRatings    PersonRating[]
  commentBanned    Boolean         @default(false)
  commentReports   CommentReport[]
  activities       Activity[]
  pageViews        PageView[]
}

model Session {
  id        String   @id // sha256 of the cookie token
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

model Plan {
  id            String         @id // "member" | "executive"
  name          String
  priceCents    Int
  interval      String         @default("month")
  tagline       String
  features      String // newline separated
  active        Boolean        @default(true)
  sortOrder     Int            @default(0)
  subscriptions Subscription[]
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId               String
  plan                 Plan      @relation(fields: [planId], references: [id])
  status               String // active | trialing | past_due | canceled
  stripeSubscriptionId String?   @unique
  priceCents           Int
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Category {
  id        String @id @default(cuid())
  name      String @unique
  slug      String @unique
  sortOrder Int    @default(0)
  posts     Post[]
}

model Post {
  id               String          @id @default(cuid())
  slug             String          @unique
  title            String
  dek              String          @default("") // subtitle / summary line
  body             String // markdown
  executiveSummary String          @default("") // markdown, members only
  coverImage       String?
  tags             String          @default("") // comma separated
  status           String          @default("draft") // draft | published | scheduled
  featured         Boolean         @default(false)
  premium          Boolean         @default(false) // whole article members-only
  readMinutes      Int             @default(5)
  views            Int             @default(0)
  unlocks          Unlock[]
  memos            Memo[]
  votes            PollVote[]
  comments         Comment[]
  quiz             Quiz?
  quizAttempts     QuizAttempt[]
  bookMentions     BookMention[]
  personMentions   PersonMention[]
  mentionsAt       DateTime? // when books/people were last extracted (null = not yet)
  speaker          String? // person interviewed, e.g. "Sam Altman"
  host             String? // interviewer, e.g. "Lenny Rachitsky"
  show             String? // podcast/channel, e.g. "Lenny's Podcast"
  source           String? // e.g. tts42
  sourceUrl        String?         @unique
  categoryId       String?
  category         Category?       @relation(fields: [categoryId], references: [id])
  authorId         String?
  author           User?           @relation(fields: [authorId], references: [id])
  authorName       String          @default("Raleche Staff")
  publishedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  dailyViews       PostView[]
}

model PostView {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  day    String // YYYY-MM-DD
  count  Int    @default(0)

  @@unique([postId, day])
}

model Subscriber {
  id             String   @id @default(cuid())
  email          String   @unique
  status         String   @default("subscribed") // subscribed | unsubscribed
  source         String   @default("site")
  unsubscribeKey String   @unique @default(cuid())
  language       String   @default("en") // language the newsletter is sent in
  createdAt      DateTime @default(now())
}

model Campaign {
  id        String    @id @default(cuid())
  subject   String
  body      String // markdown
  status    String    @default("draft") // draft | sent
  sentCount Int       @default(0)
  sentAt    DateTime?
  createdAt DateTime  @default(now())
}

model Setting {
  key   String @id
  value String
}

model ImportRun {
  id        String   @id @default(cuid())
  source    String
  created   Int      @default(0)
  updated   Int      @default(0)
  errors    String   @default("")
  createdAt DateTime @default(now())
}

/// Machine translations, keyed by a hash of (language, format, source text), so edited text is retranslated automatically.
model Translation {
  id        String   @id
  lang      String
  text      String
  createdAt DateTime @default(now())
}

/// Every token change. The balance on User is the running total; this is the audit trail.
model TokenTxn {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int // positive = earned/bought, negative = spent
  reason    String // purchase | wheel | unlock | admin
  ref       String?  @unique // Stripe checkout session, spin id or unlock id: makes credits idempotent
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// An executive summary unlocked with tokens.
model Unlock {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  tokens    Int
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

/// One prize-wheel spin. Signed-out spins wait (userId null) until the visitor signs in to claim them.
model WheelSpin {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       String // YYYY-MM-DD (UTC)
  prize     Int
  claimedAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, day])
}

/// One reader's rating of an article: great | average | not_great. Earns tokens once.
model PollVote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  choice    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, postId])
  @@index([postId])
}

model Comment {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId     String
  post       Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  body       String
  hidden     Boolean         @default(false)
  heldReason String? // set while waiting for review (hidden until an admin approves)
  reports    Int             @default(0)
  rewarded   Boolean         @default(false) // tokens are paid once the comment is public
  createdAt  DateTime        @default(now())
  reportsBy  CommentReport[]

  @@index([postId, createdAt])
  @@index([userId, createdAt])
}

model CommentReport {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
}

/// Two multiple-choice questions about an article: [{ q, options[4], answer }].
model Quiz {
  postId    String   @id
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  questions Json
  source    String   @default("ai") // seed | ai | admin
  updatedAt DateTime @updatedAt
}

/// One play per reader per article.
model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  correct   Int
  earned    Int      @default(0)
  picks     Int[]    @default([]) // the reader's chosen option per question, to show their answers in red once revealed
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

/// A reader following a speaker or host (by name, as it appears on stories).
model Follow {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // speaker | host
  name      String
  createdAt DateTime @default(now())

  @@unique([userId, kind, name])
  @@index([kind, name])
}

/// A book a guest reads, recommends, was shaped by, or wrote. Sold through Amazon affiliate links.
model Book {
  id        String        @id @default(cuid())
  slug      String        @unique
  title     String
  author    String
  asin      String? // Amazon product id; without it we link to an Amazon search
  coverUrl  String?
  createdAt DateTime      @default(now())
  mentions  BookMention[]

  @@unique([title, author])
}

model BookMention {
  id       String @id @default(cuid())
  bookId   String
  book     Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  who      String // person who mentioned it
  relation String // recommends | reading | influenced | wrote
  note     String @default("")

  @@unique([bookId, postId, who])
}

/// People a guest openly admires or criticizes in an article.
model PersonMention {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  name   String
  who    String
  stance String // admires | criticizes
  note   String @default("")

  @@index([postId])
  @@index([name])
}

/// Everything readers do that the admin wants to know about: comments, votes, spins, quizzes, purchases, unlocks, follows.
model Activity {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind      String // comment | vote | spin | quiz | purchase | unlock | follow | signup
  postId    String?
  detail    String   @default("")
  emailed   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([kind, createdAt])
}

/// One page view. visitorId is a first-party cookie (1 year); sessionId groups a visit (30 minutes of inactivity ends it).
model PageView {
  id        String   @id @default(cuid())
  visitorId String
  sessionId String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  path      String
  title     String   @default("")
  referrer  String?
  landing   Boolean  @default(false) // first page of the visit
  seconds   Int      @default(0) // time on the page, reported when the reader leaves it
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
  @@index([path, createdAt])
}

/// An in-depth memo (PDF) sold for tokens. The file is stored in the database so only buyers can fetch it.
model Memo {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  summary     String         @default("")
  postId      String?
  post        Post?          @relation(fields: [postId], references: [id], onDelete: SetNull)
  priceTokens Int            @default(100)
  active      Boolean        @default(true)
  sortOrder   Int            @default(0)
  fileName    String?
  fileType    String?
  fileSize    Int?
  fileData    Bytes?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  purchases   MemoPurchase[]
}

/// A memo bought with tokens.
model MemoPurchase {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  tokens    Int
  createdAt DateTime @default(now())

  @@unique([userId, memoId])
}

/// A reader's like (+1) or dislike (-1) of a speaker or host.
model PersonRating {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   // speaker | host
  name      String
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, kind, name])
  @@index([kind, name])
}
